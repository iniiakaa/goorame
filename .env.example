# ============================================================
# Goorame Mini-ERP — Environment Variables Template
# Salin file ini sebagai .env.local (frontend) & backend/.env
# ============================================================

# --- FRONTEND (Next.js) ---
# URL backend FastAPI yang dihosting di Railway
# Ganti dengan URL service backend Railway Anda setelah deploy
NEXT_PUBLIC_API_URL=https://goorame-backend.up.railway.app/api

# --- BACKEND (FastAPI) ---
# Railway otomatis mengisi DATABASE_URL saat Anda menambahkan
# PostgreSQL plugin di Railway dashboard
DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT Secret — GANTI dengan string acak yang kuat di production!
JWT_SECRET=goorame-super-secret-key-change-in-production

# URL Frontend (untuk CORS whitelist di backend)
FRONTEND_URL=https://goorame-frontend.up.railway.app

# Mode environment
ENV=production

