# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example but ignore actual secrets
.env
.env.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database — not for version control
*.db
*.db-shm
*.db-wal

# Python
backend/venv/
backend/__pycache__/
backend/app/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.egg-info/
dist/

